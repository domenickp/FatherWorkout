
# Dolt database files (added by bd init)
.dolt/

# --- BEGIN PORTABLE BEADS (agentic-kit) ---
# Machine-local agent settings
.claude/settings.local.json

# Machine-local secret generated by 'bd init'; bd's own .beads/.gitignore misses it
.beads/.beads-credential-key

# Beads runtime / local state (the Dolt db itself is excluded by .beads/.gitignore)
.beads/dolt-server.log
.beads/dolt-server.lock
.beads/interactions.jsonl
.beads/.local_version
.beads/backup/
.beads/*.db
.beads/*.db-shm
.beads/*.db-wal
.dolt/
# --- END PORTABLE BEADS (agentic-kit) ---
